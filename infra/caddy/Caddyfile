mat-inspect.staging {
	tls internal

	respond /health 200

	# No route to the AI Service. It has no authentication of its own, and the audio it accepts is
	# biometric PII under FOIP, so it is not published to the browser. /api/v1/ai/* falls through to
	# core-api below, which authenticates the operator and proxies the clip on the internal network
	# (ADR 0019).

	@media path /api/v1/media/*
	handle @media {
		reverse_proxy media:3000
	}

	@audit path /api/v1/reports/* /api/v1/audit/*
	handle @audit {
		reverse_proxy audit:3000
	}

	handle /api/v1/* {
		reverse_proxy core-api:3000
	}

	respond "MAT-Inspect API Gateway" 200
}

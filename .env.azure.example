# Environment for the Azure demo provisioning scripts (ADR 0024).
# Copy to .env.azure, fill in the values, then: `set -a; . ./.env.azure; set +a` before running
# scripts/azure/provision.sh. NEVER commit .env.azure. All placeholders are obviously fake.
#
# Unlike a Compose deployment, the database connection strings are NOT set here: provision.sh derives
# CORE_API_DB_URL / CORE_MIGRATOR_DB_URL / AUDIT_API_DB_URL / AUDIT_MIGRATOR_DB_URL from the
# PostgreSQL server it creates and the passwords below (each with sslmode=require). You only supply
# the passwords and the secrets.
#
# Synthetic data only (ADR 0024). Do not point anything here at a store holding real operator PII.

# --- Required secrets (provision.sh fails fast if any are unset) ---------------------------------
ENTRA_TENANT_ID=REPLACE_ME
ENTRA_CLIENT_ID=REPLACE_ME
# Reuse the existing Application Insights (works across resource groups by connection string).
APPLICATIONINSIGHTS_CONNECTION_STRING=REPLACE_ME

# PostgreSQL Flexible Server admin password (for the admin user set by PG_ADMIN_USER, default matadmin).
PG_ADMIN_PASSWORD=REPLACE_ME
# Passwords for the four least-privilege roles the script creates: audit_migrator / audit_writer on
# audit_db, and core_api_migrator / core_api_writer on core_db (DEV-146). provision.sh requires all
# four; core-api runs as core_api_writer and only migrations connect as core_api_migrator.
AUDIT_MIGRATOR_DB_PASSWORD=REPLACE_ME
AUDIT_WRITER_DB_PASSWORD=REPLACE_ME
CORE_API_MIGRATOR_DB_PASSWORD=REPLACE_ME
CORE_API_WRITER_DB_PASSWORD=REPLACE_ME

# Service-to-service bearer tokens (not Entra). Generate random values; must differ.
AUDIT_INGEST_TOKEN=REPLACE_ME
CORE_API_INTERNAL_TOKEN=REPLACE_ME

# RSA private key (PEM) for detached report signatures (ADR 0022).
# Generate once: openssl genrsa 2048  (paste the whole PEM, newlines escaped as needed).
REPORT_SIGNING_PRIVATE_KEY=REPLACE_ME

# --- Optional notifications (blank silences the channel, ADR 0013) -------------------------------
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SUPERVISOR_ALERT_EMAILS=

# --- Optional resource/config overrides (defaults shown; only set to override provision.sh) ------
# RG=MAT-Inspect               # existing resource group, reused (not recreated)
# LOC=canadacentral            # Canada region for data residency (ADR 0024)
# LAW=mat-inspect-logs         # Log Analytics workspace (reused if present)
# ACA_ENV=mat-inspect-env
# ACR=matinspect<random>       # global name; set a stable value for reruns
# SA=matinspect<random>        # global name; 3-24 lowercase alphanumeric
# AI_SHARE=ai-models
# PG=mat-inspect-pg-<random>   # global name
# PG_ADMIN_USER=matadmin
# FD=mat-inspect-fd
# TAG=latest
# BUILD_IMAGES=true            # false if images are already in the registry
# PWA_HOSTNAME=mat-inspect.example.com          # Front Door custom domain (optional)
# DASHBOARD_HOSTNAME=dashboard.mat-inspect.example.com

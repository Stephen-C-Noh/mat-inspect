# GitHub container registry owner (lowercase GitHub org or username)
REGISTRY_OWNER=REPLACE_ME

POSTGRES_USER=mat
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres
# Host port for the dev Postgres container; override if 5432 is already in use.
POSTGRES_HOST_PORT=5432

# Azure AD / Entra ID - obtain from the app registration in the Azure portal
# Required in all environments (dev runs against the personal Entra tenant). Replace with the
# app registration values from the Azure portal. A placeholder or blank value is rejected at boot.
ENTRA_TENANT_ID=REPLACE_ME
ENTRA_CLIENT_ID=REPLACE_ME

# Azure Blob Storage
# Dev/dev-staging: Azurite well-known connection string (do not change for local dev)
# Production: replace with the connection string from your Azure Storage Account in the portal
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# Azure Monitor - obtain connection string from Application Insights resource in the Azure portal
# All environments (dev, staging, prod) use a real Azure Monitor workspace
# Required in all environments except tests (NODE_ENV=test). Replace with the real connection
# string. A placeholder or blank value is rejected at boot.
APPLICATIONINSIGHTS_CONNECTION_STRING=REPLACE_ME

CORE_API_DB_URL=postgresql://mat:changeme@postgres:5432/core_db
AUDIT_API_DB_URL=postgresql://mat:changeme@postgres:5432/audit_db

# Host used by local tooling (drizzle-kit, db:migrate, db:seed) to reach postgres outside Docker.
# Default works with Docker Desktop. OrbStack users: use <compose-project>-postgres-1.orb.local
DB_HOST_LOCAL=localhost

# --- Microsoft Teams (failed-inspection fast-nudge alert, DEV-39 / ADR 0013) ---
# A FAIL_BLOCKING inspection posts an Adaptive Card to the Supervisors channel through a Power
# Automate Workflows webhook (not a legacy Office 365 connector; Microsoft is retiring those).
# Teams is best-effort with no delivery guarantee: email is the minimum guaranteed channel and
# the dashboard queue is the backstop. Leave TEAMS_WEBHOOK_URL blank to disable Teams (the alert
# is logged and skipped). When set it must be a valid https URL. A REPLACE_ME placeholder is
# rejected at boot, so fill it with the real webhook or blank it.
TEAMS_WEBHOOK_URL=

# Dashboard origin used to build the deep link in the Teams card. When set it must be a valid
# http(s) URL. Leave blank to post the card without an open-in-dashboard button.
DASHBOARD_BASE_URL=

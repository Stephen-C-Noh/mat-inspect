{
  "name": "@mat-inspect/core-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import=tsx/esm src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node --env-file=../../.env --import=tsx/esm ../../db/migrate.ts",
    "db:seed": "node --env-file=../../.env --import=tsx/esm ../../db/seed.ts"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.0.0",
    "@mat-inspect/db": "^0.0.0",
    "@mat-inspect/shared-crypto": "^0.0.0",
    "@mat-inspect/shared-schemas": "^0.0.0",
    "@mat-inspect/shared-types": "^0.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^6.2.3",
    "nodemailer": "^9.0.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.22.3"
  }
}

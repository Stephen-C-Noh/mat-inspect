# @azure/msal-react@2.x declares peers for React 16-18 but is compatible with React 19.
# Remove once msal-react publishes a version with updated peer range.
legacy-peer-deps=true

# Wait 7 days before resolving newly published package versions. A freshly published
# version can be malicious or compromised; the delay lets the ecosystem catch it first.
min-release-age=7

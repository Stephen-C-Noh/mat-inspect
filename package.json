{
  "name": "mat-inspect",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "db"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -b",
    "audit:ci": "node scripts/audit-gate.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.py": [
      "ruff format",
      "ruff check --fix"
    ],
    "Dockerfile*": [
      "hadolint"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "undici": "^7.28.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.18",
    "@types/pg": "^8.20.0",
    "testcontainers": {
      "undici": "8.9.0"
    },
    "brace-expansion@^1.0.0": "1.1.16",
    "brace-expansion@^2.0.0": "2.1.2",
    "brace-expansion@^5.0.0": "5.0.8",
    "fast-uri": "3.1.4",
    "fast-xml-parser": "^5.10.1",
    "find-my-way": "^9.7.0",
    "js-yaml": "^4.3.0",
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "sharp": "^0.35.0"
  }
}
